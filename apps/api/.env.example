# Base de datos local (PostgreSQL via Homebrew)
DATABASE_URL="postgresql://aemipn:aemipn@localhost:5433/aemipn?schema=public"

PORT=4000
NODE_ENV=development

# Origen permitido del frontend (Vite)
CORS_ORIGIN="http://localhost:5173"

# Secretos JWT — genera los tuyos con: openssl rand -base64 48
JWT_ACCESS_SECRET="cambia-esto-en-produccion"
JWT_REFRESH_SECRET="cambia-esto-tambien"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Credenciales del primer administrador que crea el seed
SEED_ADMIN_EMAIL="admin@aemipn.mx"
SEED_ADMIN_PASSWORD="Aemipn2026!"

# --- Fase 2: n8n (aún no se usa) ---
# N8N_WEBHOOK_URL=""
# N8N_SHARED_SECRET=""

# --- Correo ---
# Dirección pública del sitio, para armar la liga de verificación.
APP_URL="http://localhost:5173"
# Sin BREVO_API_KEY ni SMTP_URL los correos se imprimen en la consola del
# servidor, que es suficiente para desarrollar.
#
# BREVO_API_KEY manda por la API HTTP de Brevo (brevo.com), y tiene prioridad
# sobre SMTP_URL. Hace falta en Render: su plan gratuito bloquea las
# conexiones salientes a los puertos SMTP (25, 465, 587), así que Gmail u
# otro SMTP no funcionan ahí sin importar la configuración.
# BREVO_API_KEY=""
#
# SMTP_URL sirve donde el SMTP normal sí puede salir (este equipo, un plan de
# pago de Render, etc). Ejemplo: SMTP_URL="smtps://usuario:contrasena@smtp.gmail.com:465"
# SMTP_URL=""
SMTP_REMITENTE="AEMIPN <no-responder@aemipn.mx>"

# --- Cuentas de prueba (SOLO desarrollo) ---
# Con esto en true, `npm run db:seed` crea una cuenta por área para entrar
# como jefe y comprobar los permisos desde dentro, más un tesorero, un
# miembro raso y un recién registrado.
#
# El seed se NIEGA a crearlas si NODE_ENV es production, aunque esté en true.
# Todas comparten contraseña y viven bajo un dominio propio para poder
# borrarlas de un golpe.
SEED_CUENTAS_DEMO="false"
SEED_DEMO_PASSWORD="Demo2026!"
SEED_DEMO_DOMINIO="demo.aemipn.mx"

# Devuelve el token y el codigo de verificacion en la respuesta del registro.
# Solo para probar sin buzon. Nunca en produccion.
EXPONER_CODIGOS_DE_PRUEBA=false
