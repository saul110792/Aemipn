# El proyecto pide Node >= 20 (package.json → engines). Sin esto npm solo avisa
# y arranca de todos modos, y el fallo aparece más tarde disfrazado: con Node 16
# Vite muere con "does not provide an export named 'constants'", que no dice
# nada de la versión. Mejor negarse de entrada y con un mensaje claro.
engine-strict=true
